# ========================================================
# AL-FARRAH PRIVATE HOSPITAL SYSTEM CONFIGURATION
# إعدادات النظام وقاعدة البيانات لمستشفى الفرح الأهلي
# ========================================================

# مفتاح الذكاء الاصطناعي (Gemini API Key)
GEMINI_API_KEY=

# تفعيل أو تعطيل الربط مع مايكروسوفت سيكول سيرفر (true / false)
USE_SQL_SERVER=true

# إعدادات الاتصال بقاعدة بيانات Microsoft SQL Server
MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=hr_farah_db
MSSQL_USER=sa
MSSQL_PASSWORD=P@ssword1993
MSSQL_INSTANCE_NAME=ALFARAH_SERVER
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ========================================================
# مسارات حفظ وتخزين البيانات والمجلدات على القرص F:
# (F:\HR-farah-Hospital)
# ========================================================

# 1. مسار ملف قاعدة البيانات الشاملة للنظام
DATABASE_FILE_PATH=F:\HR-farah-Hospital\database.json

# 2. مسار حفظ النسخ الاحتياطية التلقائية واليدوية لقاعدة البيانات
BACKUP_DIRECTORY_PATH=F:\HR-farah-Hospital\backups

# 3. مسار حفظ تقارير ونتائج تحاليل المختبر (Analysis)
ANALYSIS_FOLDER_PATH=F:\HR-farah-Hospital\Analysis

# 4. مسار حفظ كتب ومنافيست كواشف ومواد المختبر الرسمية PDF
LAB_MATERIALS_PDF_SAVE_PATH=F:\HR-farah-Hospital\LabMaterials_PDF

# 5. مسار ملفات وسجلات وتوثيق مصرف الدم ونقل الدم
BLOOD_BANK_FILES_PATH=F:\HR-farah-Hospital\blood_bank_files

# 6. مسار صور الهويات والباجات التعريفية للموظفين
ID_PHOTOS_PATH=F:\HR-farah-Hospital\id_photos

# 7. مسار صور البطاقات الوطنية والمستمسكات الرسمية للمرضى
NATIONAL_ID_PHOTOS_PATH=F:\HR-farah-Hospital\national_id_photos

# 8. مسار الصور الشخصية للمرضى والمراجعين
PATIENT_PHOTOS_PATH=F:\HR-farah-Hospital\patient-photos

# 9. مسار الكتب الإدارية والملفات والوثائق العامة
GENERAL_FILES_PATH=F:\HR-farah-Hospital\general-files

# 10. مسار مستودع التخزين والملفات المرفوعة العام
STORAGE_FOLDER_PATH=F:\HR-farah-Hospital\storage

# 11. مسار مجلد الأصول والشعارات والأيقونات الثابتة
ASSETS_FOLDER_PATH=F:\HR-farah-Hospital\assets

# 12. مسار وسيط وأداة الربط مع أجهزة البصمة ZKTeco
ZK_LOCAL_AGENT_PATH=F:\HR-farah-Hospital\zk-local-agent

# ========================================================
# إعدادات الشبكة ومنافذ السيرفر وعناوين التشغيل (HTTP)
# ========================================================
HOST=0.0.0.0
PORT=4000

# رابط تشغيل النظام المحلي وعلى الشبكة الداخلية للمستشفى
APP_URL=http://10.20.11.69:4000
HTTP_SERVER_IP=10.20.11.69
VITE_APP_URL=http://10.20.11.69:4000

# روابط وواجهات برمجة النسخ الاحتياطي (Backup API Endpoints)
BACKUP_API_LIST_URL=http://10.20.11.69:4000/api/backups
BACKUP_API_DOWNLOAD_URL=http://10.20.11.69:4000/api/backups/download
BACKUP_API_CREATE_URL=http://10.20.11.69:4000/api/backups/create
BACKUP_API_RESTORE_URL=http://10.20.11.69:4000/api/backups/restore

